# ─────────────────────────────────────────────────────────────────────────────
# Makkah Food Catering & Supply Forum — environment template
# Copy to .env.local (local) or paste into Vercel (production).
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployment. Used in QR codes, emails and WhatsApp messages.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database ─────────────────────────────────────────────────────────────────
# Production (Supabase → Project Settings → Database → Connection string)
# Use the transaction pooler on port 6543 for Vercel, e.g.:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
#
# Local development: `npm run dev` starts an embedded PostgreSQL (PGlite) and
# overrides this value automatically. You can leave the default below.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?schema=public&connection_limit=5"

# Direct (non-pooled) connection — only needed when running migrations against
# Supabase from CI. Port 5432. Optional; `prisma migrate deploy` can use
# DATABASE_URL if it is the direct connection.
# DIRECT_URL=""

# ── Sessions, token encryption, IP hashing ───────────────────────────────────
# `npm run dev` generates these into .env.local on first run. In production you
# must set them yourself (each 32+ random bytes, base64url):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# 32-byte base64 key used to encrypt raw ticket tokens for re-sending emails.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Verify a sending domain in Resend, then set the from address.
RESEND_API_KEY=""
EMAIL_FROM="Makkah Food Forum <tickets@your-domain.com>"
EMAIL_REPLY_TO="info@your-domain.com"

# ── WhatsApp Business Cloud API (optional) ───────────────────────────────────
# Requires an approved Meta template that contains a URL button variable for the
# ticket link. Leave disabled until credentials and an approved template exist.
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="ticket_confirmation"
WHATSAPP_TEMPLATE_LANG="ar"
WHATSAPP_API_VERSION="v23.0"

# ── Cloudflare Turnstile (optional bot protection) ───────────────────────────
# When these are omitted, the form still has honeypot + timing + rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
